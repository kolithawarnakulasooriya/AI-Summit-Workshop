{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": ["./.agents/skills"]
  },
  "permission": {
    "skill": {
      "frontend-design": "allow",
      "web-design-guidelines": "allow",
      "webapp-testing": "allow"
    }
  },
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM",
      "options": {
        "baseURL": "http://10.10.10.184:8000/v1"
      },
      "models": {
        "dark-side-of-the-code/Qwen3-Coder-30B-A3B-Instruct-AWQ":{
          "name": "Qwen3-Coder-30B"
        }
      }
    }
  },
  "watcher": {
    "ignore": ["Instructions.md", ".gitignore","Workshop-AI-Summit.pdf"]
  }
}
